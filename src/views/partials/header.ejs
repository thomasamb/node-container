<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= pageTitle %> | Postboard</title>
    <style>
      :root {
        color-scheme: light;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #20232a;
        background: #f5f6f8;
      }

      * { box-sizing: border-box; }

      body { margin: 0; }

      a { color: #2857c5; }

      .site-header {
        background: #fff;
        border-bottom: 1px solid #e3e6eb;
      }

      .site-nav, main {
        width: min(100% - 2rem, 760px);
        margin: 0 auto;
      }

      .site-nav {
        min-height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .brand {
        color: inherit;
        font-size: 1.15rem;
        font-weight: 750;
        text-decoration: none;
      }

      main { padding: 2rem 0 4rem; }

      .page-heading, .post-meta, .comment-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .page-heading { margin-bottom: 1.5rem; }
      h1, h2, p { margin-top: 0; }
      h1 { margin-bottom: 0.35rem; font-size: clamp(1.7rem, 5vw, 2.2rem); }
      h2 { margin-bottom: 0.5rem; }
      .muted, time { color: #687080; font-size: 0.92rem; }
      .post-list { display: grid; gap: 1rem; }

      .card {
        padding: 1.25rem;
        background: #fff;
        border: 1px solid #e3e6eb;
        border-radius: 12px;
      }

      .post-title { color: inherit; text-decoration: none; }
      .post-title:hover { color: #2857c5; }
      .post-body { line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; }
      .post-meta { justify-content: flex-start; margin: 0.75rem 0 1rem; }
      .post-meta > * + *::before { content: "·"; margin-right: 0.6rem; color: #a0a6b0; }
      .comment-list { display: grid; gap: 0.75rem; margin: 1rem 0 1.5rem; }
      .comment { padding: 1rem; background: #f8f9fb; border-radius: 8px; }
      .comment p { margin: 0.5rem 0 0; white-space: pre-wrap; overflow-wrap: anywhere; }

      form { display: grid; gap: 1rem; }
      label { display: grid; gap: 0.4rem; font-weight: 650; }
      input, textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #cbd0d9;
        border-radius: 7px;
        font: inherit;
      }

      textarea { min-height: 150px; resize: vertical; }
      button, .button {
        display: inline-block;
        width: fit-content;
        padding: 0.7rem 1rem;
        color: #fff;
        background: #2857c5;
        border: 0;
        border-radius: 7px;
        font: inherit;
        font-weight: 650;
        text-decoration: none;
        cursor: pointer;
      }

      button:hover, .button:hover { background: #2048a7; }
      .text-link { font-weight: 650; text-decoration: none; }
      .empty-state { padding: 2rem; text-align: center; color: #687080; }

      @media (max-width: 520px) {
        .site-nav, main { width: min(100% - 1.25rem, 760px); }
        main { padding-top: 1.5rem; }
        .page-heading { align-items: flex-start; }
        .card { padding: 1rem; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main navigation">
        <a class="brand" href="/">Postboard</a>
        <a class="text-link" href="/posts/new">Write a post</a>
      </nav>
    </header>
    <main>
