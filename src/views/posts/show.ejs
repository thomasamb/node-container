<%- include('../partials/header', { pageTitle: post.title }) %>

<article class="card">
  <h1><%= post.title %></h1>
  <div class="post-meta">
    <span class="muted"><%= post.author %></span>
    <% if (post.createdAt) { %>
      <time datetime="<%= post.createdAt %>"><%= new Date(post.createdAt).toLocaleDateString() %></time>
    <% } %>
  </div>
  <p class="post-body"><%= post.body %></p>
  <a class="text-link" href="/">← Back to posts</a>
</article>

<section aria-labelledby="comments-title" style="margin-top: 2rem">
  <div class="comment-heading">
    <h2 id="comments-title">Comments (<%= (post.comments || []).length %>)</h2>
  </div>

  <% if (!post.comments || post.comments.length === 0) { %>
    <p class="muted">No comments yet. Start the conversation.</p>
  <% } else { %>
    <div class="comment-list">
      <% post.comments.forEach((comment) => { %>
        <article class="comment">
          <div class="post-meta">
            <strong><%= comment.author %></strong>
            <% if (comment.createdAt) { %>
              <time datetime="<%= comment.createdAt %>"><%= new Date(comment.createdAt).toLocaleDateString() %></time>
            <% } %>
          </div>
          <p><%= comment.body %></p>
        </article>
      <% }) %>
    </div>
  <% } %>

  <form class="card" action="/posts/<%= encodeURIComponent(post.id) %>/comments" method="post">
    <h2>Leave a comment</h2>
    <label for="comment-author">
      Your name
      <input id="comment-author" name="author" type="text" maxlength="80" autocomplete="name" required>
    </label>
    <label for="comment-body">
      Comment
      <textarea id="comment-body" name="body" maxlength="5000" required></textarea>
    </label>
    <button type="submit">Add comment</button>
  </form>
</section>

<%- include('../partials/footer') %>
